{
  "name": "storybook-addon-themes",
  "version": "10.0.0",
  "description": "A storybook addon to switch between different themes for your preview",
  "keywords": [
    "addon",
    "frontend",
    "react",
    "reactjs",
    "storybook",
    "storybookjs",
    "svelte",
    "theme",
    "tool",
    "ui",
    "user interface",
    "vue",
    "vuejs",
    "storybook-addon",
    "style"
  ],
  "homepage": "https://github.com/tonai/storybook-addon-themes",
  "bugs": {
    "url": "https://github.com/tonai/storybook-addon-themes/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonai/storybook-addon-themes.git"
  },
  "license": "MIT",
  "author": "tonai",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "npm run build && concurrently -k \"tsup --watch\" \"npm run storybook -w examples-app/react\"",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:examples": "npm run build && npm run build-storybook --workspaces",
    "test:e2e": "npm run build:examples && playwright test",
    "test:e2e:built": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "prepack": "npm run build",
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "pretypecheck": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.0.0",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/icons": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "http-server": "^14.1.1",
    "storybook": "10.6.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vite": "^6.3.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "storybook": {
    "displayName": "Theme switcher",
    "supportedFrameworks": [
      "react",
      "vue3",
      "svelte",
      "html",
      "preact",
      "web-components",
      "angular"
    ]
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "examples-app/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./manager": "./dist/manager.js",
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "preset.js",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "storybook": "^10.0.0"
  },
  "packageManager": "npm@11.19.1"
}
