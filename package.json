{
  "description": "A storybook addon to switch between different themes for your preview",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonai/storybook-addon-themes.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.19.1",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/icons": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.1"
  },
  "name": "storybook-addon-themes-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples-app/*"
  ],
  "scripts": {
    "build": "npm run build -w storybook-addon-themes --",
    "dev": "npm run build && concurrently -k \"npm run build -w storybook-addon-themes -- --watch\" \"npm run storybook -w examples-app/react\"",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build:examples": "npm run build && npm run build-storybook --workspaces --if-present",
    "test:e2e": "npm run build:examples && playwright test",
    "test:e2e:built": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "pretypecheck": "npm run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run build && changeset publish"
  }
}
